# ==============================================================================
# Environment Configuration - Core SaaS Starter Kit
# Validated at startup via Zod in src/core/env.ts
# ==============================================================================

# NextAuth Secret & URL
NEXTAUTH_SECRET="development-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Branding & API Base URL
NEXT_PUBLIC_APP_NAME="Core Frontend"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_DEFAULT_TENANT="default"

# Environment
NODE_ENV="development"
