# Core SaaS Backend Environment Configuration

# Server Settings
PORT=8080
ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Connection
# Option 1: Full Connection URL (primary)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_dev?sslmode=disable
DB_MAX_CONNS=10

# Option 2: Granular Connection Settings (used when DATABASE_URL is omitted)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=saas_dev
# DB_SSLMODE=disable
